[Unit]
Description=VFusion Collector Video Network Terminal
After=network.target

[Service]
Type=simple
User=vfusion
Group=vfusion
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vfusion/storage /opt/vfusion/packages
WorkingDirectory=/opt/vfusion
ExecStart=/usr/bin/node /opt/vfusion/packages/collector/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production PORT=5001

[Install]
WantedBy=multi-user.target
