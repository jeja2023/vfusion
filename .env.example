# ===================================================
# 视汇 (VFusion) 环境变量配置文件模版 (.env.example)
# 复制本文件为 .env 即可生效
# ===================================================

# ---------------------------------------------------
# 1. 预设初始账号密码 (仅在首次初始化生成数据库/用户表时生效)
# ---------------------------------------------------
VFUSION_ADMIN_PASSWORD=admin123
VFUSION_OPERATOR_PASSWORD=admin123
VFUSION_AUDITOR_PASSWORD=admin123
VFUSION_COLLECTOR_ADMIN_PASSWORD=admin123
VFUSION_COLLECTOR_OPERATOR_PASSWORD=admin123
VFUSION_COLLECTOR_AUDITOR_PASSWORD=admin123

# ---------------------------------------------------
# 2. 服务端监听端口配置 (默认: 视频网端 5001, 内网中台 5002)
# ---------------------------------------------------
COLLECTOR_PORT=5001
CORE_PORT=5002

# ---------------------------------------------------
# 3. 安全与 CORS 跨域白名单 (多个来源用英文逗号分隔)
# ---------------------------------------------------
# VFUSION_ALLOWED_ORIGINS=http://localhost:5002,http://192.168.1.100:5002

# ---------------------------------------------------
# 4. FTP 传输目录覆盖 (可选，覆盖默认 storage/ftp_in 与 ftp_out)
# ---------------------------------------------------
# FTP_IN_DIR=storage/ftp_in
# FTP_OUT_DIR=storage/ftp_out
