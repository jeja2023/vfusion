# ===================================================
# 视汇 (VFusion) 环境变量配置文件模版 (.env.example)
# 复制本文件为 .env 即可生效
# ===================================================

# ---------------------------------------------------
# 1. 预设超级管理员初始账号与密码 (仅在首次初始化生成数据库/用户表时生效)
#    - 系统首次启动时仅自动创建超级管理员账号 (用户名默认为 admin)
#    - 其他业务操作员与审计员账号须由 admin 登录控制台后手动添加。
# ---------------------------------------------------
# 【内网中台】超级管理员账号与初始密码配置
VFUSION_ADMIN_USERNAME=admin
VFUSION_ADMIN_PASSWORD=<change-this-before-start>

# 【视频网端】超级管理员账号与初始密码配置
VFUSION_COLLECTOR_ADMIN_USERNAME=admin
VFUSION_COLLECTOR_ADMIN_PASSWORD=<change-this-before-start>

# ---------------------------------------------------
# 2. 服务端监听端口配置 (默认: 视频网端 5001, 内网中台 5002)
# ---------------------------------------------------
COLLECTOR_PORT=5001
CORE_PORT=5002

# ---------------------------------------------------
# 3. 安全与 CORS 跨域白名单 (多个来源用英文逗号分隔)
# ---------------------------------------------------
# VFUSION_ALLOWED_ORIGINS=http://localhost:5002,http://192.168.1.100:5002

# ---------------------------------------------------
# 4. 在线升级补丁签名密钥 (构建补丁与目标端必须一致，至少 32 个字符)
# ---------------------------------------------------
# VFUSION_UPGRADE_SIGNING_KEY=<至少32字符的随机密钥>

# ---------------------------------------------------
# 5. FTP 传输目录与包前缀覆盖 (可选，覆盖默认 storage/ftp_in 与 ftp_out 及单据包前缀)
# ---------------------------------------------------
# FTP_IN_DIR=storage/ftp_in
# FTP_OUT_DIR=storage/ftp_out
# PKG_PREFIX=vfusion_
